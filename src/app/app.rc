#include <windows.h>
#include "resource.h"

IDI_APP ICON "assets/app.ico"

IDD_SETTINGS DIALOGEX 0, 0, 450, 275
STYLE DS_SETFONT | DS_MODALFRAME | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "Files XP Native Settings"
FONT 9, "Segoe UI"
BEGIN
    LTEXT "Language", IDC_SETTINGS_LANGUAGE_LABEL, 12, 13, 78, 10
    COMBOBOX IDC_SETTINGS_LANGUAGE, 96, 10, 194, 70, CBS_DROPDOWNLIST | WS_VSCROLL | WS_TABSTOP
    LTEXT "Default view", IDC_SETTINGS_VIEW_LABEL, 12, 38, 78, 10
    COMBOBOX IDC_SETTINGS_DEFAULT_VIEW, 96, 35, 194, 90, CBS_DROPDOWNLIST | WS_VSCROLL | WS_TABSTOP
    LTEXT "New tab location", IDC_SETTINGS_START_LABEL, 12, 63, 78, 10
    EDITTEXT IDC_SETTINGS_START, 96, 60, 194, 14, ES_AUTOHSCROLL
    CONTROL "Restore tabs after restart", IDC_SETTINGS_RESTORE, "Button", BS_AUTOCHECKBOX | WS_TABSTOP, 12, 86, 190, 12
    CONTROL "Show places pane", IDC_SETTINGS_PLACES, "Button", BS_AUTOCHECKBOX | WS_TABSTOP, 12, 103, 190, 12
    CONTROL "Use compact toolbar", IDC_SETTINGS_COMPACT, "Button", BS_AUTOCHECKBOX | WS_TABSTOP, 12, 120, 190, 12
    CONTROL "Confirm permanent deletion", IDC_SETTINGS_CONFIRM_DELETE, "Button", BS_AUTOCHECKBOX | WS_TABSTOP, 12, 137, 190, 12
    CONTROL "Enable Git commands", IDC_SETTINGS_GIT, "Button", BS_AUTOCHECKBOX | WS_TABSTOP, 12, 154, 190, 12
    CONTROL "Enable archive adapter", IDC_SETTINGS_ARCHIVES, "Button", BS_AUTOCHECKBOX | WS_TABSTOP, 12, 171, 190, 12
    CONTROL "Space opens Quick Preview", IDC_SETTINGS_PREVIEW, "Button", BS_AUTOCHECKBOX | WS_TABSTOP, 12, 188, 190, 12
    GROUPBOX "Toolbar buttons", IDC_SETTINGS_TOOLBAR_LABEL, 310, 10, 128, 164
    CONTROL "Back", IDC_SETTINGS_TOOLBAR_BACK, "Button", BS_AUTOCHECKBOX | WS_TABSTOP, 322, 32, 104, 12
    CONTROL "Forward", IDC_SETTINGS_TOOLBAR_FORWARD, "Button", BS_AUTOCHECKBOX | WS_TABSTOP, 322, 55, 104, 12
    CONTROL "Up", IDC_SETTINGS_TOOLBAR_UP, "Button", BS_AUTOCHECKBOX | WS_TABSTOP, 322, 78, 104, 12
    CONTROL "Refresh", IDC_SETTINGS_TOOLBAR_REFRESH, "Button", BS_AUTOCHECKBOX | WS_TABSTOP, 322, 101, 104, 12
    CONTROL "New Folder", IDC_SETTINGS_TOOLBAR_FOLDER, "Button", BS_AUTOCHECKBOX | WS_TABSTOP, 322, 124, 104, 12
    CONTROL "View", IDC_SETTINGS_TOOLBAR_VIEW, "Button", BS_AUTOCHECKBOX | WS_TABSTOP, 322, 147, 104, 12
    LTEXT "Preview provider", IDC_SETTINGS_PREVIEW_PROVIDER_LABEL, 310, 184, 128, 10
    COMBOBOX IDC_SETTINGS_PREVIEW_PROVIDER, 310, 197, 128, 80, CBS_DROPDOWNLIST | WS_VSCROLL | WS_TABSTOP
    PUSHBUTTON "Reset", IDC_SETTINGS_RESET, 12, 249, 54, 16
    DEFPUSHBUTTON "OK", IDOK, 324, 249, 54, 16
    PUSHBUTTON "Cancel", IDCANCEL, 384, 249, 54, 16
END

IDD_COMMAND_PALETTE DIALOGEX 0, 0, 320, 224
STYLE DS_SETFONT | DS_MODALFRAME | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "Command Palette"
FONT 9, "Segoe UI"
BEGIN
    EDITTEXT IDC_PALETTE_QUERY, 10, 10, 300, 16, ES_AUTOHSCROLL
    LISTBOX IDC_PALETTE_LIST, 10, 32, 300, 160, LBS_NOTIFY | WS_VSCROLL | WS_TABSTOP
    DEFPUSHBUTTON "Run", IDOK, 198, 200, 54, 16
    PUSHBUTTON "Cancel", IDCANCEL, 256, 200, 54, 16
END

IDD_TAGS DIALOGEX 0, 0, 286, 92
STYLE DS_SETFONT | DS_MODALFRAME | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "Tags"
FONT 9, "Segoe UI"
BEGIN
    LTEXT "Separate tags with semicolons. Blank removes tags.", IDC_TAGS_PROMPT, 10, 10, 266, 20
    EDITTEXT IDC_TAGS_EDIT, 10, 34, 266, 16, ES_AUTOHSCROLL
    DEFPUSHBUTTON "OK", IDOK, 164, 66, 54, 16
    PUSHBUTTON "Cancel", IDCANCEL, 222, 66, 54, 16
END

IDD_SHORTCUTS DIALOGEX 0, 0, 350, 174
STYLE DS_SETFONT | DS_MODALFRAME | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "Keyboard Shortcuts"
FONT 9, "Segoe UI"
BEGIN
    LTEXT "Select a field, then press the new shortcut.", IDC_SHORTCUTS_INSTRUCTIONS, 10, 10, 330, 18
    LTEXT "New Tab", IDC_SHORTCUTS_NEW_TAB_LABEL, 14, 36, 132, 10
    EDITTEXT IDC_SHORTCUTS_NEW_TAB, 154, 33, 176, 15, ES_AUTOHSCROLL | ES_READONLY | WS_TABSTOP
    LTEXT "Close Tab", IDC_SHORTCUTS_CLOSE_TAB_LABEL, 14, 56, 132, 10
    EDITTEXT IDC_SHORTCUTS_CLOSE_TAB, 154, 53, 176, 15, ES_AUTOHSCROLL | ES_READONLY | WS_TABSTOP
    LTEXT "Address", IDC_SHORTCUTS_ADDRESS_LABEL, 14, 76, 132, 10
    EDITTEXT IDC_SHORTCUTS_ADDRESS, 154, 73, 176, 15, ES_AUTOHSCROLL | ES_READONLY | WS_TABSTOP
    LTEXT "Search", IDC_SHORTCUTS_SEARCH_LABEL, 14, 96, 132, 10
    EDITTEXT IDC_SHORTCUTS_SEARCH, 154, 93, 176, 15, ES_AUTOHSCROLL | ES_READONLY | WS_TABSTOP
    LTEXT "Command Palette", IDC_SHORTCUTS_PALETTE_LABEL, 14, 116, 132, 10
    EDITTEXT IDC_SHORTCUTS_PALETTE, 154, 113, 176, 15, ES_AUTOHSCROLL | ES_READONLY | WS_TABSTOP
    LTEXT "New Folder", IDC_SHORTCUTS_FOLDER_LABEL, 14, 136, 132, 10
    EDITTEXT IDC_SHORTCUTS_FOLDER, 154, 133, 176, 15, ES_AUTOHSCROLL | ES_READONLY | WS_TABSTOP
    DEFPUSHBUTTON "OK", IDOK, 218, 152, 54, 16
    PUSHBUTTON "Cancel", IDCANCEL, 278, 152, 54, 16
END

IDD_NAME_PROMPT DIALOGEX 0, 0, 310, 94
STYLE DS_SETFONT | DS_MODALFRAME | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "Name"
FONT 9, "Segoe UI"
BEGIN
    LTEXT "Enter a name.", IDC_NAME_PROMPT, 10, 10, 290, 20
    EDITTEXT IDC_NAME_EDIT, 10, 34, 290, 16, ES_AUTOHSCROLL | WS_TABSTOP
    DEFPUSHBUTTON "OK", IDOK, 188, 68, 54, 16
    PUSHBUTTON "Cancel", IDCANCEL, 246, 68, 54, 16
END

IDD_SHORTCUT_EDITOR DIALOGEX 0, 0, 390, 158
STYLE DS_SETFONT | DS_MODALFRAME | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "Create Shortcut"
FONT 9, "Segoe UI"
BEGIN
    LTEXT "Name", IDC_LINK_NAME_LABEL, 10, 13, 86, 10
    EDITTEXT IDC_LINK_NAME, 102, 10, 278, 15, ES_AUTOHSCROLL | WS_TABSTOP
    LTEXT "Target", IDC_LINK_TARGET_LABEL, 10, 37, 86, 10
    EDITTEXT IDC_LINK_TARGET, 102, 34, 278, 15, ES_AUTOHSCROLL | WS_TABSTOP
    LTEXT "Arguments", IDC_LINK_ARGUMENTS_LABEL, 10, 61, 86, 10
    EDITTEXT IDC_LINK_ARGUMENTS, 102, 58, 278, 15, ES_AUTOHSCROLL | WS_TABSTOP
    LTEXT "Start in", IDC_LINK_WORKING_LABEL, 10, 85, 86, 10
    EDITTEXT IDC_LINK_WORKING, 102, 82, 278, 15, ES_AUTOHSCROLL | WS_TABSTOP
    LTEXT "Icon path", IDC_LINK_ICON_LABEL, 10, 109, 86, 10
    EDITTEXT IDC_LINK_ICON, 102, 106, 278, 15, ES_AUTOHSCROLL | WS_TABSTOP
    DEFPUSHBUTTON "Create", IDOK, 258, 134, 58, 16
    PUSHBUTTON "Cancel", IDCANCEL, 322, 134, 58, 16
END

IDD_TAG_COLOR DIALOGEX 0, 0, 270, 82
STYLE DS_SETFONT | DS_MODALFRAME | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "Tag Color"
FONT 9, "Segoe UI"
BEGIN
    LTEXT "Tag", IDC_TAG_COLOR_LABEL, 10, 12, 250, 12
    COMBOBOX IDC_TAG_COLOR_COMBO, 10, 30, 250, 100, CBS_DROPDOWNLIST | WS_VSCROLL | WS_TABSTOP
