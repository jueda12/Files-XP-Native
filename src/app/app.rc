IDD_ARCHIVE DIALOGEX 0, 0, 360, 152
STYLE DS_SETFONT | DS_MODALFRAME | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "Archive"
FONT 9, "Segoe UI"
BEGIN
    LTEXT "Archive name", IDC_ARCHIVE_NAME_LABEL, 12, 14, 100, 10
    EDITTEXT IDC_ARCHIVE_NAME, 118, 11, 228, 15, ES_AUTOHSCROLL | WS_TABSTOP
    LTEXT "Format", IDC_ARCHIVE_FORMAT_LABEL, 12, 42, 100, 10
    COMBOBOX IDC_ARCHIVE_FORMAT, 118, 39, 228, 70, CBS_DROPDOWNLIST | WS_VSCROLL | WS_TABSTOP
    LTEXT "Password", IDC_ARCHIVE_PASSWORD_LABEL, 12, 70, 100, 10
    EDITTEXT IDC_ARCHIVE_PASSWORD, 118, 67, 228, 15, ES_AUTOHSCROLL | ES_PASSWORD | WS_TABSTOP
    LTEXT "Existing items", IDC_ARCHIVE_COLLISION_LABEL, 12, 98, 100, 10
    COMBOBOX IDC_ARCHIVE_COLLISION, 118, 95, 228, 70, CBS_DROPDOWNLIST | WS_VSCROLL | WS_TABSTOP
    DEFPUSHBUTTON "OK", IDOK, 234, 126, 54, 16
    PUSHBUTTON "Cancel", IDCANCEL, 292, 126, 54, 16
END

IDD_SHELF DIALOGEX 0, 0, 390, 238
STYLE DS_SETFONT | DS_MODALFRAME | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "Shelf"
FONT 9, "Segoe UI"
BEGIN
    LISTBOX IDC_SHELF_LIST, 10, 10, 286, 218, LBS_NOTIFY | WS_VSCROLL | WS_HSCROLL | WS_TABSTOP
    PUSHBUTTON "Remove", IDC_SHELF_REMOVE, 306, 10, 74, 18
    PUSHBUTTON "Move Up", IDC_SHELF_UP, 306, 34, 74, 18
    PUSHBUTTON "Move Down", IDC_SHELF_DOWN, 306, 58, 74, 18
    DEFPUSHBUTTON "Paste Here", IDC_SHELF_PASTE, 306, 184, 74, 18
    PUSHBUTTON "Close", IDCANCEL, 306, 210, 74, 18
END

IDD_FTP DIALOGEX 0, 0, 500, 322
STYLE DS_SETFONT | DS_MODALFRAME | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "FTP Manager"
FONT 9, "Segoe UI"
BEGIN
    LTEXT "Server URL", IDC_FTP_URL_LABEL, 10, 12, 66, 10
    EDITTEXT IDC_FTP_URL, 80, 9, 330, 15, ES_AUTOHSCROLL | WS_TABSTOP
    DEFPUSHBUTTON "Connect", IDC_FTP_CONNECT, 416, 8, 74, 17
    LTEXT "Username", IDC_FTP_USERNAME_LABEL, 10, 38, 66, 10
    EDITTEXT IDC_FTP_USERNAME, 80, 35, 150, 15, ES_AUTOHSCROLL | WS_TABSTOP
    LTEXT "Password", IDC_FTP_PASSWORD_LABEL, 240, 38, 54, 10
    EDITTEXT IDC_FTP_PASSWORD, 298, 35, 112, 15, ES_AUTOHSCROLL | ES_PASSWORD | WS_TABSTOP
    CONTROL "Require TLS", IDC_FTP_REQUIRE_TLS, "Button", BS_AUTOCHECKBOX | WS_TABSTOP, 416, 35, 74, 15
    PUSHBUTTON "Up", IDC_FTP_UP, 10, 62, 54, 17
    PUSHBUTTON "Refresh", IDC_FTP_REFRESH, 68, 62, 64, 17
    LTEXT "Ready", IDC_FTP_STATUS, 140, 65, 350, 11, SS_LEFTNOWORDWRAP
    LISTBOX IDC_FTP_LIST, 10, 85, 360, 191, LBS_NOTIFY | LBS_NOINTEGRALHEIGHT | WS_VSCROLL | WS_HSCROLL | WS_TABSTOP
    PUSHBUTTON "Open Folder", IDC_FTP_OPEN, 380, 85, 110, 18
    PUSHBUTTON "Download Here", IDC_FTP_DOWNLOAD, 380, 109, 110, 18
    PUSHBUTTON "Upload File...", IDC_FTP_UPLOAD, 380, 133, 110, 18
    PUSHBUTTON "New Folder...", IDC_FTP_NEW_FOLDER, 380, 157, 110, 18
    PUSHBUTTON "Delete File", IDC_FTP_DELETE_FILE, 380, 181, 110, 18
    PUSHBUTTON "Delete Folder", IDC_FTP_DELETE_FOLDER, 380, 205, 110, 18
    PUSHBUTTON "Cancel Transfer", IDC_FTP_CANCEL_TRANSFER, 380, 253, 110, 18
    PUSHBUTTON "Close", IDCANCEL, 436, 295, 54, 17
END

